<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <ProgressBar
            android:id="@+id/progress_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/brand_gold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_error_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/status_progress_text"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Project not found" />

        <LinearLayout
            android:id="@+id/layout_content_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_detail_image"
                android:layout_width="match_parent"
                android:layout_height="@dimen/detail_banner_height"
                android:background="@color/brand_surface_variant"
                android:contentDescription="@string/section_projects_title"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/brand_gold"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="tunneru" />

                <TextView
                    android:id="@+id/tv_detail_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_live"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="@string/status_live"
                    android:textColor="@color/status_live_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="@string/section_architecture_overview"
                android:textColor="@color/brand_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_narrative"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/brand_card"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="@color/brand_text_primary"
                android:textSize="12.5sp"
                tools:text="tunneru is a lightweight zero-dependency tunneling engine, binary multiplexer, and real-time request inspection suite built in raw go from first principles..." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.08"
                android:text="@string/section_tech_stack"
                android:textColor="@color/brand_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_tech"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Action Dock Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_github_code"
                style="@style/Widget.Kirin.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/action_view_code"
                android:textSize="12.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_live_demo"
                style="@style/Widget.Kirin.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/action_open_demo"
                android:textSize="12.5sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
